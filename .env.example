PORT=3118

DB_HOST=localhost
DB_PORT=3306
DB_USER=knightsrook_mcp
DB_PASSWORD=your_password_here
DB_NAME=knightsrook_mcp

# memory2thought dual-write (syncs MCP topics to your Codex)
M2T_DB_HOST=mysql.railway.internal
M2T_DB_PORT=3306
M2T_DB_USER=root
M2T_DB_PASSWORD=password
M2T_DB_NAME=railwayev
M2T_CLERK_USER_ID=user_replace_with_your_clerk_id

# Bearer tokens required on every /mcp request. Comma-separated to allow
# overlap during rotation. A write token implicitly grants read.
# Generate with: node -e "console.log('krk_' + require('crypto').randomBytes(32).toString('base64url'))"
# KRK_MCP_TOKENS_RW is required — the process refuses to start without it.
KRK_MCP_TOKENS_RW=krk_replace_with_generated_token
KRK_MCP_TOKENS_RO=krk_replace_with_generated_readonly_token

# Public base URL this server is reachable at — used to build OAuth
# discovery/issuer URLs (see "OAuth" in README). Must be the real public
# HTTPS origin in production; defaults to localhost for local dev.
PUBLIC_URL=https://mcp.knightsrook.com